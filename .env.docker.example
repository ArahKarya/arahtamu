POSTGRES_USER=fdm
POSTGRES_PASSWORD=fdm
POSTGRES_DB=fdm

APP_PORT=3001
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# GENERATE: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-random-min-32-chars-xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=replace-with-another-random-min-32-chars-yyyyyyyyyy

# Bcrypt rounds — 12 modern default. Raise to 13 for high-value targets.
BCRYPT_ROUNDS=12

SEED_ADMIN_EMAIL=admin@fdm.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

AUTO_SEED=true
SEED_TIMEOUT_MS=120000

# RPi5 / ARM64 — slow IO; raise these if seed/migrate timeouts during cold start.
DATABASE_CONNECTION_TIMEOUT_MS=30000

# Optional integrations — leave blank to disable
SENTRY_DSN=
RESEND_API_KEY=
# EMAIL_FROM accepts "Display Name <email@domain>" format (Resend recommended).
# When deploying SaaS apps, use a domain you've verified in Resend (e.g. mail.yourapp.com).
EMAIL_FROM=FDM <noreply@fdm.local>
EMAIL_REPLY_TO=

# Google Sign-In — set to true and supply GOOGLE_CLIENT_ID to enable Helmet COOP/CSP relax.
ALLOW_GOOGLE_SIGNIN=false
GOOGLE_CLIENT_ID=

# Cloudflare Tunnel (RPi5 deploy via tunnel name "fdm") — token used by cloudflared sidecar
# CLOUDFLARE_TUNNEL_TOKEN=
