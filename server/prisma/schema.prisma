generator client {
  provider      = "prisma-client-js"
  // Pin engine binaries — node:20-alpine (musl) di RPi5 (arm64) butuh openssl-3.0.x.
  // Tanpa ini, deteksi native salah jadi openssl-1.1.x → runtime crash "could not locate Query Engine".
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  uploads       FileUpload[]
  hostProfile   Host?

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  // familyId tracks token rotation lineage. When reuse is detected (a revoked token is
  // presented again), the entire family is revoked — defeats stolen-token replay attacks.
  familyId        String
  expiresAt       DateTime
  revokedAt       DateTime?
  // Reason for revocation: 'rotated' | 'logout' | 'reuse_detected' | 'password_changed' | 'admin_revoked'
  revokedReason   String?
  // The rotated successor's id — useful for forensic auditing.
  replacedById    String?
  createdAt       DateTime  @default(now())
  ip              String?
  userAgent       String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model FileUpload {
  id         String   @id @default(cuid())
  userId     String?
  originalName String
  storedName String
  mimeType   String
  size       Int
  path       String
  entity     String?
  entityId   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@map("file_uploads")
}

// ─── FDM VMS — Master Data (Fase 0) ────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  hosts       Host[]

  @@map("departments")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  capacity  Int?
  openHours String?  @map("open_hours")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  visits    Visit[]
  preregistrations Preregistration[]

  @@map("locations")
}

model Host {
  id           String      @id @default(cuid())
  name         String
  email        String
  phone        String?
  departmentId String?     @map("department_id")
  userId       String?     @unique @map("user_id")
  photoUrl     String?     @map("photo_url")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits       Visit[]
  preregistrations Preregistration[]

  @@index([departmentId])
  @@map("hosts")
}

// ─── FDM VMS — Kunjungan (Fase 1) ──────────────────────────────────────

enum VisitStatus {
  PREREGISTERED
  CHECKED_IN
  CHECKED_OUT
  DENIED
  NO_SHOW
}

enum HostConfirmation {
  PENDING
  ACCEPTED
  REJECTED
}

model Visitor {
  id        String   @id @default(cuid())
  fullName  String   @map("full_name")
  company   String?
  phone     String
  email     String?
  idNumber  String?  @map("id_number")
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  visits    Visit[]

  @@index([phone])
  @@map("visitors")
}

model Visit {
  id           String      @id @default(cuid())
  visitorId    String      @map("visitor_id")
  hostId       String      @map("host_id")
  locationId   String      @map("location_id")
  purpose      String?
  status       VisitStatus @default(CHECKED_IN)
  hostConfirmation HostConfirmation @default(PENDING) @map("host_confirmation")
  hostConfirmedAt  DateTime?        @map("host_confirmed_at")
  hostNote         String?          @map("host_note")
  checkInAt    DateTime?   @map("check_in_at")
  checkOutAt   DateTime?   @map("check_out_at")
  photoUrl     String?     @map("photo_url")
  signatureUrl String?     @map("signature_url")
  badgeCode    String?     @unique @map("badge_code")
  formData     Json?       @map("form_data")
  createdBy    String?     @map("created_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  visitor      Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  host         Host        @relation(fields: [hostId], references: [id])
  location     Location    @relation(fields: [locationId], references: [id])
  preregistration Preregistration?
  consentLogs  ConsentLog[]

  @@index([status])
  @@index([hostId])
  @@index([locationId])
  @@map("visits")
}

// ─── FDM VMS — Watchlist & Pra-registrasi (Fase 2) ─────────────────────

enum WatchlistLevel {
  WATCH
  BLOCK
}

enum PreregStatus {
  PENDING
  USED
  EXPIRED
  CANCELLED
}

model Watchlist {
  id        String         @id @default(cuid())
  fullName  String         @map("full_name")
  phone     String?
  idNumber  String?        @map("id_number")
  reason    String
  level     WatchlistLevel @default(WATCH)
  createdBy String?        @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([phone])
  @@map("watchlists")
}

model Preregistration {
  id          String       @id @default(cuid())
  hostId      String       @map("host_id")
  locationId  String       @map("location_id")
  visitorData Json         @map("visitor_data")
  purpose     String?
  scheduledAt DateTime     @map("scheduled_at")
  qrToken     String       @unique @map("qr_token")
  status      PreregStatus @default(PENDING)
  visitId     String?      @unique @map("visit_id")
  createdBy   String?      @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  host        Host         @relation(fields: [hostId], references: [id])
  location    Location     @relation(fields: [locationId], references: [id])
  visit       Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([hostId])
  @@map("preregistrations")
}

// ─── FDM VMS — Consent / UU PDP (Fase 3) ───────────────────────────────

enum ConsentType {
  NDA
  TATA_TERTIB
  PDP
}

model Consent {
  id        String      @id @default(cuid())
  type      ConsentType
  title     String
  version   String
  contentMd String      @map("content_md")
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  logs      ConsentLog[]

  @@index([active])
  @@map("consents")
}

model ConsentLog {
  id        String   @id @default(cuid())
  visitId   String   @map("visit_id")
  consentId String   @map("consent_id")
  version   String
  ip        String?
  signedAt  DateTime @default(now()) @map("signed_at")
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  consent   Consent  @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("consent_logs")
}
