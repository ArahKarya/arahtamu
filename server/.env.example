# Application
NODE_ENV=development
PORT=3015
APP_URL=http://localhost:3015
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://arahtamu:arahtamu@localhost:5432/arahtamu?schema=public

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# Logging
LOG_LEVEL=info

# Bull Board (admin UI)
BULL_BOARD_PATH=/admin/queues

# Seed
SEED_ADMIN_EMAIL=admin@arahtamu.local
SEED_ADMIN_PASSWORD=admin123
